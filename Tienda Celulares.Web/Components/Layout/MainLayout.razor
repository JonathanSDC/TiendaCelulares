@inherits LayoutComponentBase
@using Tienda_Celulares.Web.Components.Pages
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using Tienda_Celulares.Web.Services
@inject AuthStateService AuthState




<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="topbar d-flex justify-content-between align-items-center p-2 shadow-sm bg-light">
            <div class="d-flex align-items-center gap-3">
                @if (string.IsNullOrEmpty(CurrentUser))
                {
                    <NavLink class="btn btn-outline-primary" href="/login">
                        <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesion
                    </NavLink>
                }
                else
                {
                    <span class="fw-bold text-primary">👤 @CurrentUser</span>
                    <button class="btn btn-outline-danger" @onclick="Logout">
                        <i class="bi bi-box-arrow-right"></i> Finalizar sesión
                    </button>
                }
            </div>

            <div>
                <button class="btn btn-success">
                    <i class="bi bi-person-plus"></i> Nuevo Usuario
                </button>
            </div>
        </div>

        <article class="content px-4 py-2">
            @Body
        </article>
    </main>
</div>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;

    private string? CurrentUser;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Cargar usuario guardado al renderizar
            CurrentUser = await LocalStorage.GetItemAsync<string>("currentUser");

            // Suscribirse a cambios en AuthState
            AuthState.OnChange += UpdateUser;

            StateHasChanged(); // refresca el layout
        }
    }

    private void UpdateUser()
    {
        CurrentUser = AuthState.CurrentUser;
        StateHasChanged(); // 🔹 refresca automáticamente cuando cambie
    }

    private async Task Logout()
    {
        await LocalStorage.RemoveItemAsync("currentUser");
        AuthState.CurrentUser = null; // Producto
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthState.OnChange -= UpdateUser;
    }
}
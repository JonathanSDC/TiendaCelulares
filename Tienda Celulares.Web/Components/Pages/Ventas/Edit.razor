@page "/ventas/edit/{id:int}"

@using System.Net.Http.Json
@using CRUD.Shared.Models
@using CRUD.Shared.Models.ViewModel

@inject HttpClient Http
@inject NavigationManager Navigation

<h3 class="mb-4">Editar Venta</h3>

@if (modelo != null)
{
        <EditForm Model="modelo"
                  OnValidSubmit="Guardar">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">

                <label class="form-label">
                    Estado
                </label>

                <InputSelect class="form-select"
                             @bind-Value="modelo.Estado">

                    <option value="pendiente">
                        Pendiente
                    </option>

                    <option value="completada">
                        Completada
                    </option>

                    <option value="cancelada">
                        Cancelada
                    </option>

                </InputSelect>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Total Venta
                </label>

                <InputNumber class="form-control"
                             @bind-Value="modelo.TotalVenta" />

            </div>

            <button class="btn btn-success">
                Guardar
            </button>

        </EditForm>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private VentaViewModel modelo = new();

    protected override async Task OnInitializedAsync()
    {
        var venta =
            await Http.GetFromJsonAsync<VentaViewModel>(
                $"api/ventas/{Id}"
            );

        if (venta != null)
        {
            modelo = venta;
        }
    }

    private async Task Guardar()
    {
        var response =
            await Http.PutAsJsonAsync(
                $"api/ventas/{modelo.IdVenta}",
                modelo
            );

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/ventas");
        }
    }
}
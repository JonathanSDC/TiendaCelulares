@page "/ventas"

@using System.Net.Http.Json
@using CRUD.Shared.Models
@using CRUD.Shared.Models.ViewModel


@inject HttpClient Http
@inject NavigationManager Navigation

<h3 class="mb-4">Ventas</h3>

<div class="mb-3">

    <button class="btn btn-primary"
            @onclick="NuevaVenta">
        Nueva Venta
    </button>

</div>

<input class="form-control mb-3"
       placeholder="Buscar venta..."
       @bind="busqueda" />

<table class="table table-striped table-hover">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Cliente</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in VentasFiltradas)
        {
                <tr>

                    <td>@item.IdVenta</td>

                    <td>@item.ClienteNombre</td>

                    <td>@item.FechaHora.ToString("dd/MM/yyyy")</td>

                    <td>C$ @item.TotalVenta</td>

                    <td>@item.Estado</td>

                    <td>

                        <button class="btn btn-warning btn-sm me-2"
                                @onclick="() => Editar(item.IdVenta)">
                            Editar
                        </button>

                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Eliminar(item.IdVenta)">
                            Eliminar
                        </button>

                    </td>

                </tr>
        }

    </tbody>

</table>

@code {

    private List<VentaViewModel> ventas = new();

    private string busqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var resultado =
            await Http.GetFromJsonAsync<List<VentaViewModel>>(
                "api/ventas"
            );

        if (resultado != null)
        {
            ventas = resultado;
        }
    }

    private IEnumerable<VentaViewModel> VentasFiltradas =>
        ventas.Where(v =>
            string.IsNullOrWhiteSpace(busqueda)
            ||
            v.ClienteNombre!.Contains(
                busqueda,
                StringComparison.OrdinalIgnoreCase
            )
        );

    private void NuevaVenta()
    {
        Navigation.NavigateTo("/ventas/create");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/ventas/edit/{id}");
    }

    private async Task Eliminar(int id)
    {
        var response =
            await Http.DeleteAsync($"api/ventas/{id}");

        if (response.IsSuccessStatusCode)
        {
            var venta =
                ventas.FirstOrDefault(v => v.IdVenta == id);

            if (venta != null)
            {
                ventas.Remove(venta);
            }
        }
    }
}
@page "/ventas/create"
@using System.Net.Http.Json
@using CRUD.Shared.Models
@using CRUD.Shared.Models.ViewModel
@using CRUD.Shared.Dto
@inject HttpClient Http
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<h3 class="mb-4">Nueva Venta</h3>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Cliente -->
    <div class="mb-3">
        <label class="form-label">Cliente</label>
        <InputSelect class="form-control" @bind-Value="modelo.IdCliente">
            <option value="0">-- Seleccione cliente --</option>
            @foreach (var c in Clientes)
            {
                <option value="@c.Id">@c.NombreCompleto</option>
            }
        </InputSelect>
    </div>

    <!-- Empleado (solo lectura) -->
    <div class="mb-3">
        <label class="form-label">Empleado</label>
        <input class="form-control" value="@EmpleadoNombre" disabled />
    </div>

    <!-- Método de pago -->
    <div class="mb-3">
        <label class="form-label">Método Pago</label>
        <InputSelect class="form-control" @bind-Value="modelo.IdMetodo">
            <option value="0">-- Seleccione método --</option>
            @foreach (var m in MetodosPago)
            {
                <option value="@m.Id">@m.Nombre</option>
            }
        </InputSelect>
    </div>

    <!-- Tienda -->
    <div class="mb-3">
        <label class="form-label">Tienda</label>
        <InputSelect class="form-control" @bind-Value="modelo.IdTienda">
            <option value="0">-- Seleccione tienda --</option>
            @foreach (var t in Tiendas)
            {
                <option value="@t.Id">@t.Nombre</option>
            }
        </InputSelect>
        <button type="button" class="btn btn-link" @onclick="AbrirModalTienda">+ Agregar nueva tienda</button>
    </div>

    <!-- Agregar producto al detalle -->
    <div class="mb-3">
        <label class="form-label">Agregar producto</label>
        <div class="d-flex gap-2">
            <InputSelect class="form-control" @bind-Value="productoSeleccionadoId">
                <option value="0">-- Producto --</option>
                @foreach (var p in Productos)
                {
                    <option value="@p.Id">@p.NombreModelo (@p.PrecioActual.ToString("C"))</option>
                }
            </InputSelect>

            <InputNumber class="form-control" @bind-Value="cantidadSeleccionada" Min="1" />

            <button type="button" class="btn btn-primary" @onclick="AgregarDetalle">Agregar</button>
        </div>

        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in detalles)
                {
                    <tr>
                        <td>@d.NombreProducto</td>
                        <td>@d.Cantidad</td>
                        <td>@d.PrecioUnitario.ToString("C")</td>
                        <td>@(d.Cantidad* d.PrecioUnitario).ToString("C")</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => QuitarDetalle(d)">Quitar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Total calculado (solo lectura) -->
    <div class="mb-3">
        <label class="form-label">Total Venta</label>
        <input class="form-control" value="@TotalFormateado" disabled />
    </div>

    <button type="submit" class="btn btn-success" disabled="@(!PuedeGuardar)">Guardar</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Volver</button>
</EditForm>


<!--PANTALLA MODAL PARA TIENDA-->
@if (mostrarModalTienda)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Agregar Nueva Tienda</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalTienda"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="nuevaTienda" OnValidSubmit="GuardarTienda">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre</label>
                                <InputText class="form-control" @bind-Value="nuevaTienda.Nombre" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Calle</label>
                                <InputText class="form-control" @bind-Value="nuevaTienda.Calle" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Ciudad</label>
                                <InputText class="form-control" @bind-Value="nuevaTienda.Ciudad" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Departamento</label>
                                <InputText class="form-control" @bind-Value="nuevaTienda.Departamento" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">País</label>
                                <InputText class="form-control" @bind-Value="nuevaTienda.Pais" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success me-2">
                                <i class="bi bi-check-circle"></i> Guardar
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModalTienda">
                                <i class="bi bi-x-circle"></i> Cancelar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}



@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger mt-2">@mensajeError</div>
}


@code {
    // Usas tu VentaViewModel existente
    private VentaViewModel modelo = new VentaViewModel
    {
        FechaHora = DateTime.Now,
        Estado = "Pendiente"
    };

    // Catálogos
    private List<ClienteDto> Clientes = new();
    private List<MetodoPagoDto> MetodosPago = new();
    private List<TiendaDto> Tiendas = new();
    private List<ProductoDto> Productos = new();

    // Detalles en memoria
    private List<DetalleVentaViewModel> detalles = new();

	// Para validar stock, cargamos inventarios al seleccionar tienda
    private List<InventarioDto> Inventarios = new();

	// Inventarios para validación de stock
    private string mensajeError = string.Empty;

    private int productoSeleccionadoId = 0;
    private int cantidadSeleccionada = 1;

    private string EmpleadoNombre = "";
    private int EmpleadoId = 0;

    

    protected override async Task OnInitializedAsync()
    {
        Clientes = await Http.GetFromJsonAsync<List<ClienteDto>>("api/clientes") ?? new List<ClienteDto>();
        MetodosPago = await Http.GetFromJsonAsync<List<MetodoPagoDto>>("api/metodos") ?? new List<MetodoPagoDto>();
        Tiendas = await Http.GetFromJsonAsync<List<TiendaDto>>("api/tiendas") ?? new List<TiendaDto>();
        Productos = await Http.GetFromJsonAsync<List<ProductoDto>>("api/productos") ?? new List<ProductoDto>();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var claimId = user.FindFirst("empleadoId")?.Value;
            if (int.TryParse(claimId, out var idEmp))
            {
                EmpleadoId = idEmp;
                modelo.IdEmpleado = EmpleadoId;
            }
            EmpleadoNombre = user.Identity.Name ?? "Empleado";
        }

		// Cargar todos los inventarios para validación de stock. Alternativamente, podrías cargar solo los de la tienda seleccionada en el evento de cambio del select.
        Inventarios = await Http.GetFromJsonAsync<List<InventarioDto>>("api/inventario") ?? new();


    }

	// Para mostrar mensajes de error al agregar productos al detalle 
    private void AgregarDetalle()
    {
        mensajeError = string.Empty;

        if (productoSeleccionadoId == 0 || cantidadSeleccionada <= 0) return;

        var prod = Productos.FirstOrDefault(p => p.Id == productoSeleccionadoId);
        if (prod == null) return;

        // Buscar inventario de esa tienda
        var inventario = Inventarios.FirstOrDefault(i => i.IdProducto == prod.Id && i.IdTienda == modelo.IdTienda);

        if (inventario == null)
        {
            // Producto no existe en esa tienda
            mensajeError = $"El producto {prod.NombreModelo} no está disponible en la tienda seleccionada.";
            return;
        }

        if (inventario.Cantidad < cantidadSeleccionada)
        {
            // Stock insuficiente
            mensajeError = $"Stock agotado: solo quedan {inventario.Cantidad} unidades en esta tienda.";
            return;
        }

        // Si pasa validación, agregar detalle
        var detalle = new DetalleVentaViewModel
        {
            IdProducto = prod.Id,
            NombreProducto = prod.NombreModelo,
            Cantidad = cantidadSeleccionada,
            PrecioUnitario = prod.PrecioActual
        };

        detalles.Add(detalle);
        inventario.Cantidad -= cantidadSeleccionada; // actualizar stock local
        RecalcularTotal();

        productoSeleccionadoId = 0;
        cantidadSeleccionada = 1;
    }


    private void QuitarDetalle(DetalleVentaViewModel d)
    {
        detalles.Remove(d);
        RecalcularTotal();
    }

    private void RecalcularTotal()
    {
        modelo.TotalVenta = detalles.Sum(x => x.Cantidad * x.PrecioUnitario);
    }

    private string TotalFormateado => modelo.TotalVenta.ToString("C");

    private bool PuedeGuardar => modelo.IdCliente > 0 && modelo.IdMetodo > 0 && modelo.IdTienda > 0 && detalles.Any();

    private async Task Guardar()
    {
        modelo.ClienteNombre = Clientes.FirstOrDefault(c => c.Id == modelo.IdCliente)?.NombreCompleto ?? string.Empty;
        // Adjuntar detalles al modelo. Si tu VentaViewModel no tiene Detalles, envía un DTO que los incluya.
        var payload = new
        {
            venta = modelo,
            detalles = detalles
        };

        var response = await Http.PostAsJsonAsync("api/ventas", payload);
        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/ventas");
        }
        else
        {
            // manejar error
        }
    }

    private void Volver() => Navigation.NavigateTo("/ventas");



	//Pantalla Modal para agregar tienda desde la creación de venta

    private bool mostrarModalTienda = false;
    private TiendaDto nuevaTienda = new TiendaDto();

    private void AbrirModalTienda()
    {
        nuevaTienda = new TiendaDto();
        mostrarModalTienda = true;
    }

    private void CerrarModalTienda()
    {
        mostrarModalTienda = false;
    }

    private async Task GuardarTienda()
    {
        var response = await Http.PostAsJsonAsync("api/tiendas", nuevaTienda);
        if (response.IsSuccessStatusCode)
        {
            // refrescar lista de tiendas
            Tiendas = await Http.GetFromJsonAsync<List<TiendaDto>>("api/tiendas") ?? new();
            // seleccionar la nueva tienda automáticamente
            var creada = await response.Content.ReadFromJsonAsync<TiendaDto>();
            if (creada != null)
            {
                modelo.IdTienda = creada.Id;
            }
            mostrarModalTienda = false;
        }
        else
        {
            // manejar error
        }
    }


}







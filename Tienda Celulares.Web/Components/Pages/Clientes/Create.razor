    private async Task Guardar(EditContext editContext)
    {
        // Forzamos la fecha para cumplir con el NOT NULL de SQL
        modelo.FechaRegistro = DateTime.Now;

        // Si el ID es 0, a veces el API se confunde si espera un null o no espera el campo
        // Asegúrate de que los campos obligatorios tengan datos básicos
        if (string.IsNullOrEmpty(modelo.TipoCliente)) modelo.TipoCliente = "Natural";

        var response = await Http.PostAsJsonAsync("api/clientes", modelo);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/clientes");
        }
        else
        {
            // Esto nos ayudará a ver el código de estado (400, 404, 500...)
            var status = response.StatusCode;
            var mensaje = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Error {status}: {mensaje}");
        }
    }



    private void Volver()
    {
        Navigation.NavigateTo("/clientes");
    }
}
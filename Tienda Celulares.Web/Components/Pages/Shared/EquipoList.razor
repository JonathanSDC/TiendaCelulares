@inject InventarioService InventarioService

@if (isLoading) { <div>Cargando equipos…</div> }
else if (equipos.Count == 0) { <div class="text-muted">No hay equipos.</div> }
else
{
    <table class="table table-striped table-sm">
        <thead><tr><th>Serie</th><th>Producto</th><th>Estado</th><th>Color</th><th>Tienda</th></tr></thead>
        <tbody>
            @foreach (var e in equipos) {
                <tr>
                    <td>@e.NumeroSerie</td>
                    <td>@e.Producto</td>
                    <td>@e.Estado</td>
                    <td>@e.Color</td>
                    <td>@e.Tienda</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<EquipoDto> equipos = new();
    private bool isLoading;

    protected override async Task OnInitializedAsync() => await Load();

    public async Task Load()
    {
        isLoading = true;
        try { equipos = await InventarioService.GetEquiposAsync(); }
        finally { isLoading = false; }
    }
}

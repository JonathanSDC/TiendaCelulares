@page "/"

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-5">

                    <div class="text-center mb-5">

                        <h1 class="display-4 fw-bold text-primary">
                            Tienda de Celulares
                        </h1>

                        <p class="lead text-secondary mt-3">
                            Sistema de gestión moderno para administración de ventas,
                            inventario, clientes, productos y servicio técnico.
                        </p>

                    </div>

                    <hr class="mb-5" />

                    <div class="row text-center">

                        <div class="col-md-4 mb-4">

                            <div class="p-4 rounded-4 bg-light shadow-sm h-100">

                                <h3 class="fw-bold text-dark">
                                    Ventas
                                </h3>

                                <p class="text-muted mt-3">
                                    Control completo de ventas, facturación,
                                    métodos de pago y devoluciones.
                                </p>

                            </div>

                        </div>

                        <div class="col-md-4 mb-4">

                            <div class="p-4 rounded-4 bg-light shadow-sm h-100">

                                <h3 class="fw-bold text-dark">
                                    Inventario
                                </h3>

                                <p class="text-muted mt-3">
                                    Administración de stock, equipos físicos,
                                    movimientos y productos disponibles.
                                </p>

                            </div>

                        </div>

                        <div class="col-md-4 mb-4">

                            <div class="p-4 rounded-4 bg-light shadow-sm h-100">

                                <h3 class="fw-bold text-dark">
                                    Clientes
                                </h3>

                                <p class="text-muted mt-3">
                                    Gestión de clientes, historial de compras,
                                    garantías y atención personalizada.
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="text-center mt-5">

                        <h5 class="fw-semibold text-secondary">
                            Bienvenido al sistema administrativo
                        </h5>

                        <p class="text-muted">
                            Utiliza el menú lateral para comenzar a gestionar la tienda.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
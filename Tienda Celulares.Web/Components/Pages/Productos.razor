@page "/productos"
@rendermode InteractiveServer

@using Tienda_Celulares.Web.Models
@using Tienda_Celulares.Web.Services
@using Microsoft.EntityFrameworkCore


@inject ProductoService productoService

<h3 class="mb-4">Gestión de Productos</h3>

<div class="row mb-4">

    <div class="col-md-4">

        <input class="form-control"
        placeholder="Buscar producto..."
        @bind="busqueda"
        @bind:event="oninput" />

    </div>

</div>


<div class="card p-4 mb-4">

    <div class="row">

        <div class="col-md-4 mb-3">
            <label>Modelo</label>

            <input class="form-control"
            @bind="producto.nombre_modelo" />
        </div>

        <div class="col-md-4 mb-3">
            <label>Precio</label>

            <input type="number"
            class="form-control"
            @bind="producto.precio_actual" />
        </div>

        <!--Tipo-->
    <div class="col-md-4 mb-3">
    <label>Tipo</label>
    <select class="form-select" @onchange="OnTipoChanged">
        <option value="">Seleccione tipo...</option>
        <option value="Teléfono">Teléfono</option>
        <option value="Tablet">Tablet</option>
        <option value="Repuesto">Repuesto</option>
        <option value="Accesorio">Accesorio</option>
    </select>
</div>

<!--Marca-->

<div class="col-md-4 mb-3">
            <label class="form-label fw-bold">Marca</label>
            <select class="form-select" @bind="producto.id_marca">
                <option value="">Seleccione marca...</option>
                @foreach (var m in marcas)
                {
                        <option value="@m.id_marca">@m.nombre_marca</option>
                }
            </select>
        </div>
    </div>

<!--CATEGORIA-->
<div class="col-md-4 mb-3">
    <label>Categoría</label>
    <select class="form-select" @bind="producto.id_categoria">
        <option value="">Seleccione categoría...</option>
                @foreach (var c in categoriasFiltradas) // Usamos la lista filtrada
                {
                <option value="@c.id_categoria">@c.nombre_categoria</option>
                }
    </select>
</div>

  

    <div class="mb-3">
        <label>Descripción</label>

        <textarea class="form-control"
        @bind="producto.descripcion">
        </textarea>
    </div>

    <button class="btn btn-primary"
    @onclick="GuardarProducto">

        @(modoEditar ? "Actualizar" : "Guardar")

    </button>

    @if (modoEditar)
    {
        <button class="btn btn-secondary ms-2"
        @onclick="CancelarEdicion">

            Cancelar

        </button>
    }

</div>

<table class="table table-striped table-hover">

    <thead class="table-dark">

        <tr>
            <th>ID</th>
            <th>Modelo</th>
            <th>Marca</th>    
            <th>Categoría</th>
            <th>Precio</th>
            <th>Tipo</th>
            <th>Acciones</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var p in ProductosPaginados)
        {
            <tr>

                <td>@p.id_producto</td>
                <td>@p.nombre_modelo</td>
                    <td>@(p.Marca?.nombre_marca ?? "Sin Marca")</td>
                    <td>@(p.Categoria?.nombre_categoria ?? "Sin Categoría")</td>
                <td>$ @p.precio_actual</td>
                <td>@p.tipo_producto</td>

                <td>

                    <button class="btn btn-warning btn-sm me-2"
                    @onclick="() => Editar(p)">

                        Editar

                    </button>

                    <button class="btn btn-danger btn-sm"
                    @onclick="() => Eliminar(p.id_producto)">

                        Eliminar

                    </button>

                </td>

            </tr>
        }

    </tbody>

</table>

<!--Buscador-->
<nav>

    <ul class="pagination">

        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">

            <button class="page-link"
                    @onclick="PaginaAnterior">

                Anterior

            </button>

        </li>

        @for (int i = 1; i <= TotalPaginas; i++)
        {
            int pagina = i;

                <li class="page-item @(paginaActual == pagina ? "active" : "")">

                    <button class="page-link"
                            @onclick="() => IrPagina(pagina)">

                    @pagina

                    </button>

                </li>
        }

        <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">

            <button class="page-link"
                    @onclick="PaginaSiguiente">

                Siguiente

            </button>

        </li>

    </ul>

</nav>






@code {
	//Para almacenar el término de búsqueda ingresado por el usuario.
    string busqueda = "";

    int paginaActual = 1;

    int registrosPorPagina = 5;

    List<Producto> productos = new();

    Producto producto = new Producto { tipo_producto = "telefono" };

    /// <summary>
	/// Busquea y filtra los productos según el término de búsqueda ingresado por el usuario.
	/// </summary>
	IEnumerable<Producto> ProductosFiltrados =>
    productos.Where(p =>
        string.IsNullOrWhiteSpace(busqueda)
        ||
        p.nombre_modelo.Contains(
            busqueda,
            StringComparison.OrdinalIgnoreCase
        ));

    //Agregar paginación lógica
    IEnumerable<Producto> ProductosPaginados =>
    ProductosFiltrados
    .Skip((paginaActual - 1) * registrosPorPagina)
    .Take(registrosPorPagina);

    int TotalPaginas =>
        (int)Math.Ceiling(
            ProductosFiltrados.Count()
            / (double)registrosPorPagina);

	/// Indica si el formulario está en modo de edición (true) o creación (false).
    bool modoEditar = false;

    // Para el filtrado dinámico de categorías según el tipo de producto seleccionado

    private List<Categoria> todasLasCategorias = new();
    private List<Categoria> categoriasFiltradas = new();

    List<Marca> marcas = new();
    List<Categoria> categorias = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
        // Cargar los datos al iniciar la página
        marcas = await productoService.ObtenerMarcas();
        categorias = await productoService.ObtenerCategorias();

        // Cargar datos desde el servicio
        marcas = await productoService.ObtenerMarcas();
        todasLasCategorias = await productoService.ObtenerCategorias();

        // Si ya hay un tipo seleccionado (al editar), filtrar de inmediato
        ActualizarCategorias();
    }

	// Método que se ejecuta cuando el usuario cambia el tipo de producto en el formulario

    private void OnTipoChanged(ChangeEventArgs e)
    {
        // Asignar el valor seleccionado al modelo
        producto.tipo_producto = e.Value?.ToString() ?? "";

        // Ejecutar la lógica de filtrado de categorías
        ActualizarCategorias();
    }

    async Task CargarProductos()
    {
        productos = await productoService.ObtenerProductos();
    }

    async Task GuardarProducto()
    {
        if (modoEditar)
        {
            await productoService.EditarProducto(producto);
        }
        else
        {
            await productoService.CrearProducto(producto);
        }

        producto = new Producto();

        modoEditar = false;

        await CargarProductos();
    }

    void Editar(Producto p)
    {
        producto = new Producto
            {
                id_producto = p.id_producto,
                nombre_modelo = p.nombre_modelo,
                descripcion = p.descripcion,
                precio_actual = p.precio_actual,
                tipo_producto = p.tipo_producto
            };

        modoEditar = true;
    }

    async Task Eliminar(int id)
    {
        await productoService.EliminarProducto(id);

        await CargarProductos();
    }

    void CancelarEdicion()
    {
        producto = new Producto();

        modoEditar = false;
    }

	// Navegación de páginas
    void IrPagina(int pagina)
    {
        paginaActual = pagina;
    }

    void PaginaAnterior()
    {
        if (paginaActual > 1)
            paginaActual--;
    }

    void PaginaSiguiente()
    {
        if (paginaActual < TotalPaginas)
            paginaActual++;
    }

	


    private void ActualizarCategorias()
    {
        if (string.IsNullOrEmpty(producto.tipo_producto))
        {
            categoriasFiltradas = new();
        }
        else
        {
            // Filtramos las categorías basándonos en el texto que contienen 
            // o según la lógica que prefieras de tu base de datos
            categoriasFiltradas = todasLasCategorias
                .Where(c => DeterminarSiPertenece(c.nombre_categoria, producto.tipo_producto))
                .ToList();
        }
    }

    // Lógica simple de coincidencia
    private bool DeterminarSiPertenece(string nombreCat, string tipo)
    {
        if (tipo == "Teléfono") return nombreCat.Contains("Gama") || nombreCat.Contains("Smartphone");
        if (tipo == "Tablet") return nombreCat.Contains("Android") || nombreCat.Contains("iPad") || nombreCat.Contains("Windows");
        if (tipo == "Repuesto") return new[] { "Pantalla", "Batería", "Placa", "Cámara", "Conector" }.Any(nombreCat.Contains);
        if (tipo == "Accesorio") return new[] { "Funda", "Protector", "Cargador", "Audífono", "Power" }.Any(nombreCat.Contains);
        return false;
    }


}